{
  "services": {
    "web": {
      "root": "apps/web/"
    },
    "api": {
      "root": "apps/api/",
      "entrypoint": "src/app.ts",
      "outputDirectory": ".",
      "buildCommand": "pnpm build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}