{
  "services": {
    "web": {
      "root": "apps/web/"
    },
    "api": {
      "root": "apps/api/",
      "entrypoint": "dist/app.js",
      "buildCommand": "pnpm build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}